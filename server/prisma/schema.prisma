// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nickname     String
  createdAt    DateTime @default(now()) @map("created_at")
  prompts      Prompt[]
  aiTasks      AiTask[]
  usageLogs    UsageLog[]
  @@map("users")
}

model Prompt {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  title      String      @db.VarChar(200)
  body       String
  isFavorite Boolean     @default(false) @map("is_favorite")
  createdAt  DateTime    @default(now()) @map("created_at")
  user       User        @relation(fields: [userId], references: [id])
  tags       PromptTag[]
  aiTasks    AiTask[]
  @@index([userId])
  @@map("prompts")
}

model Tag {
  id      Int         @id @default(autoincrement())
  name    String      @unique @db.VarChar(50)
  prompts PromptTag[]
  @@map("tags")
}

model PromptTag {
  promptId Int @map("prompt_id")
  tagId    Int @map("tag_id")
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([promptId, tagId])
  @@map("prompt_tags")
}

// AI 优化任务：异步任务的状态机行（queued → running → done / failed）
model AiTask {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  promptId  Int      @map("prompt_id")
  status    String   @default("queued") // queued / running / done / failed
  result    String?  // done 时：AI 优化结果
  error     String?  // failed 时：失败原因（排障第一现场）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade) // 提示词删了，它的任务记录跟着删
  @@index([userId])
  @@map("ai_tasks")
}

// 用量日志：每次 AI 调用记一行，每日限额的计数依据（Task 3 启用）
model UsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   // 动作名，目前只有 "optimize"
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@map("usage_logs")
}
