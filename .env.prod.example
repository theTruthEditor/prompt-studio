# 生产/彩排环境变量模板——复制为 .env.prod 后填真值
# （.env.prod 已被 git 忽略，永远不进仓库；上云时也是这样手工放到服务器上）
#
# 本地彩排：DOMAIN 保持 localhost（Caddy 对 localhost 只走 HTTP，不签证书）
# 上云之后：DOMAIN 改成你的域名 + 三项密钥全部换强随机值

DOMAIN=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请改成强随机密码
POSTGRES_DB=prompt_studio
JWT_SECRET=请改成另一串强随机值（生产与开发必须不同源）
AI_DAILY_LIMIT=20
